msgstr "Command rejected · check the target and state"

msgid "준비 반영 완료"
msgstr "Preparation updated"

msgid "주방 데이터 오류 · 영업을 시작할 수 없습니다"
msgstr "Kitchen data error · service cannot start"

msgid "주방 데이터를 불러올 수 없습니다"
msgstr "Could not load kitchen data"

msgid "주문을 불러올 수 없습니다"
msgstr "Could not load orders"

msgid "%s%s %s · 우선 %d\n%s"
msgstr "%s%s %s · priority %d\n%s"

msgid "작업 중"
msgstr "Working"

msgid "현재 공정 후 담당 변경"
msgstr "Duty changes after this process"

msgid "직원 %d · %s"
msgstr "Employee %d · %s"

msgid "적용 대기 %d건%s"
msgstr "%d commands queued%s"

msgid " · 재개하면 반영"
msgstr " · applies after resume"

msgid "명령 반영 완료"
msgstr "Command applied"

msgid "주문 상태가 바뀌어 명령을 적용하지 못했습니다"
msgstr "The command was rejected because the order state changed"

msgid "준비 데이터 오류 · 영업을 시작할 수 없습니다"
msgstr "Preparation data error · service cannot start"

msgid "시작 예산 %s · 발주 %s · 고정 인건비 %s\n남은 예산 %s · 준비 노동량 %d / %d\n주문 %d건 · %s"
msgstr "Starting budget %s · purchases %s · fixed labor %s\nRemaining budget %s · preparation capacity %d / %d\n%d orders · %s"

msgid "영업 시작 가능"
msgstr "Ready to start"

msgid "준비를 확인하세요"
msgstr "Check preparation"

msgid "준비 중 · 발주·프렙과 배치·담당을 선택한 뒤 시작하세요"
msgstr "Preparing · choose purchases, prep, placement, and duties before starting"

msgid "제공 %d / %d건 (%.0f%%) · 취소 %d · 미제공 %d\n매출 %s · 재료비 %s · 인건비 %s\n폐기 %s · 손익 %s · 남은 예산 %s"
msgstr "Served %d / %d (%.0f%%) · cancelled %d · unserved %d\nRevenue %s · ingredients %s · labor %s\nWaste %s · profit %s · cash %s"

msgid "메뉴 · %s\n예산 %s · 재료비 %s · 인건비 %s\n%s · 주문 %d건"
msgstr "Menu · %s\nBudget %s · ingredients %s · labor %s\n%s · %d orders"

msgid "주문 %d / %d건 · 제공 %d · 미제공 %d · 취소 %d\n매출 %s · 남은 재료 · %s"
msgstr "Orders %d / %d · served %d · unserved %d · cancelled %d\nRevenue %s · stock · %s"

msgid "%s %d"
msgstr "%s %d"

msgid "\n프렙 · "
msgstr "\nPrep · "

msgid "%s · %.1f초 남음"
msgstr "%s · %.1f s remaining"

msgid "%s · 우선순위 %d\n%s"
msgstr "%s · priority %d\n%s"

msgid "신규 담당 없음"
msgstr "No new duties"

msgid "배정할 주문 없음"
msgstr "No order to assign"

msgid "주문별 누적 시간"
msgstr "Cumulative order time"

msgid "여러 주문을 합한 값입니다.\n영업 시간보다 클 수 있습니다."
msgstr "Totals include multiple orders.\nThey can exceed the service duration."

msgid "%s · %.1f초"
msgstr "%s · %.1f s"

msgid "  담당 부재 %.1f초 / 작업 중 %.1f초"
msgstr "  Unassigned %.1f s / busy %.1f s"

msgid "이동 · %.1f초\n작업 · %.1f초"
msgstr "Moving · %.1f s\nWorking · %.1f s"

msgid "\n가장 긴 대기 · %s\n이 수치만으로 손실 원인을 단정할 수 없습니다."
msgstr "\nLongest wait · %s\nThis value alone does not prove the cause of a loss."

msgid "대기 없음"
msgstr "No waiting"

msgid "\n설비별 예약·사용 시간\n재료를 가져오는 이동 중 예약도 포함합니다."
msgstr "\nStation reservation and use time\nIncludes reservations while collecting ingredients."

msgid "발주·프렙"
msgstr "Purchases and prep"

msgid "배치·담당"
msgstr "Placement and duties"

msgid "요약"
msgstr "Summary"

msgid "원재료 발주 · 한 개씩 조절"
msgstr "Raw ingredient purchases · adjust one at a time"

msgid "프렙 · 영업 중 손질을 미리 준비"
msgstr "Prep · prepare ingredients before service"

msgid "↑ 위"
msgstr "↑ Up"

msgid "← 왼쪽"
msgstr "← Left"

msgid "↓ 아래"
msgstr "↓ Down"

msgid "→ 오른쪽"
msgstr "→ Right"

msgid "작업 방향 ↻ 회전"
msgstr "Rotate work side ↻"

msgid "기본 준비로 초기화"
msgstr "Reset preparation"

msgid "%s · 노란 테두리\n위치 (%d, %d) · 작업 위치 (%d, %d)"
msgstr "%s · yellow outline\nTile (%d, %d) · work tile (%d, %d)"

msgid "%s %d개\n개당 %d"
msgstr "%s × %d\n%d each"

msgid "%s %d개\n노동 %d / 개"
msgstr "%s × %d\nCapacity %d each"

msgid "준비 확정 후 영업이 시작됩니다."
msgstr "Service starts after preparation is confirmed."

msgid "원재료와 프렙은 이번 영업에만 사용합니다."
msgstr "Raw ingredients and prep apply only to this service."

msgid "시작 재고"
msgstr "Starting stock"

msgid "%s · %d개"
msgstr "%s · %d"

msgid "\n설비를 가까이 두면 이동이 줄어듭니다.\n프렙과 우선순위의 효과는 마감 지표로 비교하세요."
msgstr "\nNearby stations reduce movement.\nUse closing metrics to compare prep and priority choices."

msgid "예산이 부족합니다 · 고정 인건비도 남겨 두세요"
msgstr "Budget is too low · reserve the fixed labor cost"

msgid "원재료가 부족합니다 · 발주를 늘리거나 프렙을 줄이세요"
msgstr "Raw ingredients are short · purchase more or reduce prep"

msgid "준비 노동량이 부족합니다 · 다른 프렙을 줄여 보세요"
msgstr "Preparation capacity is short · reduce other prep"

msgid "다른 설비나 장애물과 겹칩니다"
msgstr "Overlaps another station or obstacle"

msgid "벽이나 주방 밖에는 놓을 수 없습니다"
msgstr "Cannot place on a wall or outside the kitchen"

msgid "작업 위치는 설비 옆 한 칸이어야 합니다"
msgstr "The work tile must be adjacent to the station"

msgid "작업 위치가 막힙니다"
msgstr "The work tile is blocked"

msgid "직원 시작 위치를 막을 수 없습니다"
msgstr "Cannot block an employee start tile"

msgid "설비 사이의 이동 경로가 막힙니다"
msgstr "The route between stations is blocked"

msgid "만들 수 없는 메뉴가 있습니다 · 원재료나 프렙을 확보하세요"
msgstr "A menu cannot be made · secure raw ingredients or prep"

msgid "영업 중에는 준비를 바꿀 수 없습니다"
msgstr "Preparation cannot change during service"

msgid "준비를 적용할 수 없습니다 · 선택과 데이터를 확인하세요"
msgstr "Could not apply preparation · check the selection and data"

msgid "첫 영업"
msgstr "First service"

msgid "Chef al Mando · 첫 영업"
msgstr "Chef al Mando · First service"

msgid "기본 흐름"
msgstr "Basic flow"

msgid "채소 샐러드 한 메뉴로 시작합니다. 준비를 확인하고 영업을 시작하세요. 언제든 일시정지할 수 있습니다. 마감 후 제공 수와 손익을 확인합니다."
msgstr "Start with one vegetable salad menu. Review preparation and begin service. You can pause at any time. At closing, review the served count and profit."

msgid "점심 전 준비"
msgstr "Lunch preparation"

msgid "프렙 배분"
msgstr "Prep allocation"

msgid "수프의 손질은 샐러드보다 오래 걸립니다. 같은 노동량으로 무엇을 미리 준비하면 기다리는 주문이 줄어들지 비교하세요."
msgstr "Soup takes longer to prep than salad. With the same capacity, compare which advance preparation reduces waiting orders."

msgid "화구 앞 대기"
msgstr "Hot-station queue"

msgid "온식 우선순위"
msgstr "Hot-order priority"

msgid "구이는 매출이 높지만 화구를 오래 사용합니다. 구이를 미리 손질하고 재료·냉식·화구·제공대 사이의 동선을 줄이세요. 준비 화면에서 구이의 기본 우선순위를 높이면 새 주문에 자동으로 적용됩니다. 주문은 총 20건이며, 시간 초과된 주문은 미제공으로 집계됩니다."
msgstr "Grilled dishes earn more but occupy the hot station longer. Prepare them before service and shorten routes between storage, cold, hot, and pass stations. Raise their default priority during preparation to apply it to new orders automatically. There are 20 orders in total. Expired orders count as unserved."

msgid "메뉴별 기본 우선순위 · 0~2\n큰 값부터 배정 · 새 주문에 적용\n영업 중 주문별 변경 가능"
msgstr "Default menu priorities · 0–2\nHigher values go first for new orders.\nChange individual orders during service."

msgid "%s · 우선순위 %d"
msgstr "%s · priority %d"

msgid "\n메뉴별 기본 우선순위"
msgstr "\nDefault menu priorities"

msgid "나눠 쓰는 재료"
msgstr "Shared ingredients"

msgid "공동 재고와 발주"
msgstr "Shared stock and purchasing"

msgid "채소를 여러 메뉴가 나눠 씁니다. 발주와 프렙을 함께 조절해 재료 부족과 남는 재료의 비용을 비교하세요."
msgstr "Several menus share vegetables. Adjust purchases and prep together, then compare shortages with leftover cost."

msgid "먼 출고대"
msgstr "Distant pass"

msgid "설비 동선"
msgstr "Station routes"

msgid "가림벽 너머 출고대로 음식이 이동합니다. 준비 중 설비를 옮겨 접근 가능한 작업 위치와 실제 이동 시간을 확인하세요."
msgstr "Food moves to a pass beyond a partition. During preparation, move stations and inspect reachable work tiles and actual travel time."

msgid "네 사람의 주방"
msgstr "Four-person kitchen"

msgid "담당 분리"
msgstr "Split duties"

msgid "냉식 작업대와 화구가 둘씩 있습니다. 네 직원의 담당을 나누고, 담당 직원 대기와 작업대 사용 시간을 함께 확인하세요."
msgstr "The kitchen has two cold stations and two hot stations. Split four employee duties, then inspect employee waits and station use time."

msgid "몰려오는 주문"
msgstr "Order rush"

msgid "주문 유입과 프렙"
msgstr "Order arrivals and prep"

msgid "여덟 메뉴의 주문이 빠르게 들어옵니다. 주문 구성을 보고 프렙을 배분하고, 영업 중 우선순위로 밀리는 주문을 조절하세요."
msgstr "Orders for eight menus arrive quickly. Allocate prep from the order mix, then adjust orders delayed by priorities during service."

msgid "마지막 영업"
msgstr "Final service"

msgid "전체 운영 조합"
msgstr "Combined operations"

msgid "마지막 영업입니다. 느린 온식 주문이 먼저 들어옵니다. 발주, 프렙, 동선, 담당을 함께 조절해 목표를 달성하세요."
msgstr "This is the final service. Slow hot orders arrive first. Combine purchasing, prep, routes, and duties to reach the goal."

msgid "손질한 채소 샐러드 재료"
msgstr "Prepped vegetable salad ingredients"

msgid "손질한 곡물 수프 재료"
msgstr "Prepped grain soup ingredients"

msgid "손질한 곡물 샐러드 재료"
msgstr "Prepped grain salad ingredients"

msgid "손질한 단백질 구이 재료"
msgstr "Prepped grilled protein ingredients"

msgid "손질한 버섯 샐러드 재료"
msgstr "Prepped mushroom salad ingredients"

msgid "손질한 버섯 수프 재료"
msgstr "Prepped mushroom soup ingredients"

msgid "손질한 단백질 덮밥 재료"
msgstr "Prepped protein rice-bowl ingredients"

msgid "손질한 곡물 볶음 재료"
msgstr "Prepped stir-fried grain ingredients"

msgid "오픈 소스 라이선스"
msgstr "Open source licenses"

msgid "Godot 엔진 소스: %s"
msgstr "Godot Engine source: %s"

msgid "Godot 라이선스: %s"
msgstr "Godot licenses: %s"


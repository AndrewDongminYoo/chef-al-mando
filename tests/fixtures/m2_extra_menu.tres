[resource]
script = ExtResource("scenario")
id = "m2_extra_menu"
seed = 0
closing_tick = 3000
starting_budget = 10000
labor_cost = 2000
prep_labor_capacity = 6
grid_size = Vector2i(12, 8)

ingredients = Array[ExtResource("ingredient")]([SubResource("Ingredient_vegetable"), SubResource("Ingredient_grain"), SubResource("Ingredient_protein"), SubResource("Ingredient_prepped_salad"), SubResource("Ingredient_prepped_soup"), SubResource("Ingredient_prepped_grill"), SubResource("Ingredient_prepped_grain_salad")])

recipes = Array[ExtResource("recipe")]([SubResource("Recipe_salad"), SubResource("Recipe_soup"), SubResource("Recipe_grill"), SubResource("Recipe_grain_salad")])

stations = Array[ExtResource("station")]([SubResource("Station_storage_01"), SubResource("Station_cold_01"), SubResource("Station_hot_01"), SubResource("Station_pass_01")])

employees = Array[ExtResource("employee")]([SubResource("Employee_employee_01"), SubResource("Employee_employee_02")])

purchases = Dictionary[String, int]({"vegetable": 22, "grain": 8, "protein": 8})
menu_ids = PackedStringArray("grain_salad", "salad", "soup", "grill")
order_count = 20
first_arrival_tick = 10
arrival_interval_ticks = 140
